// Отображение Контактных лиц в форме. Шагинян С.В. 06.09.2026
#Область КонтактныеЛица

&НаСервере
Процедура УстановитьВидимостьКонтактныхЛиц()
	
	ЭтоНовый = Не ЗначениеЗаполнено(Объект.Ссылка);
	Элементы.ЗаписатьИзКонтактныхЛиц.Видимость = ЭтоНовый;
	Элементы.КонтактныеЛица.Видимость = Не ЭтоНовый;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборКонтактныхЛиц(ОбъектСсылка)
	
	Параметр = ЭтотОбъект.КонтактныеЛица.Параметры.Элементы.Найти("Владелец");  
	Если Параметр <> Неопределено Тогда 
		Параметр.Значение = ОбъектСсылка;
		Параметр.Использование = Истина;
	КонецЕсли;
	
КонецПроцедуры     

&НаКлиенте
Процедура Подключаемый_ЗаписьИзКонтакныхЛиц(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если НавигационнаяСсылкаФорматированнойСтроки = "ЗаписатьИзКонтактныхЛиц" Тогда
		Если ПроверитьЗаполнение() Тогда
			Записать();  
			УстановитьОтборКонтактныхЛиц(Объект.Ссылка);
			УстановитьВидимостьКонтактныхЛиц();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПередНачаломДобавленияКЛ(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Отказ = Истина;
	
	СтруктураЗаполнения = Новый Структура("Владелец", Объект.Ссылка); 
	ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения", СтруктураЗаполнения);
	
	ОткрытьФорму("Справочник.КЛ_КонтактныеЛица.ФормаОбъекта", ПараметрыОткрытия, Элемент,
		КлючУникальности, , , , РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);  

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыборКЛ(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Ключ", ВыбраннаяСтрока);
	ПараметрыОткрытия.Вставить("БлокироватьВладельца", Истина);
	
	ОткрытьФорму("Справочник.КЛ_КонтактныеЛица.ФормаОбъекта", ПараметрыОткрытия, Элемент,
		КлючУникальности, , , , РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);  

КонецПроцедуры

