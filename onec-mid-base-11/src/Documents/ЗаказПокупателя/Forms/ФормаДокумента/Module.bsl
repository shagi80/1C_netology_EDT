// Учет скдики при расчете цен. Шагинян С.В. 06.09.2026  
#Область ПроцедурыИФункцииРаботыСоСкидкой

&НаКлиенте
Процедура Подключаемый_ПересчетСоСкидкой(Команда) 

	ПересчитатьТаблицу();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииСкидки(Элемент)
	
	ТребуетсяПересчет = (Объект.Товары.Количество() > 0 ИЛИ Объект.Услуги.Количество() > 0);
	Если ТребуетсяПересчет Тогда
		ПересчитатьСПодтверждением();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТаблицу()
	
	Для Каждого Товар Из Объект.Товары Цикл 
		Товар.Сумма = РассчитатьСуммуСтрокиСУчетомСкидки(Товар);
	КонецЦикла;     
	
	Для Каждого Услуга Из Объект.Услуги Цикл
		Услуга.Сумма = РассчитатьСуммуСтрокиСУчетомСкидки(Услуга);
	КонецЦикла;   
	
	РассчитатьСуммуДокумента();

КонецПроцедуры

&НаКлиенте
Асинх Процедура ПересчитатьСПодтверждением()
	
	Ответ = Ждать ВопросАсинх(НСтр("ru = 'Пересчитать таблицу?'"), РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Да, НСтр("ru = 'Скидка изменена'"));  
		
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПересчитатьТаблицу();
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Функция РассчитатьСуммуСтрокиСУчетомСкидки(ТекущиеДанные)
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("Количество", ТекущиеДанные.Количество);
	ДанныеСтроки.Вставить("Цена", ТекущиеДанные.Цена);
	ДанныеСтроки.Вставить("Скидка", ТекущиеДанные.Скидка);
	ДанныеСтроки.Вставить("СогласованнаяСкидка", Объект.КЛ_СогласованнаяСкидка);
	
	Возврат РассчитатьСуммуСтрокиНаСервере(ДанныеСтроки);
	
КонецФункции  

&НаСервереБезКонтекста
Функция РассчитатьСуммуСтрокиНаСервере(ДанныеСтроки) 
	
	Возврат Документы.ЗаказПокупателя.РассчитатьСуммуСтрокиСУчетомСкидки(ДанныеСтроки);
	
КонецФункции  

#КонецОбласти  

#КонецОбласти
